# ──────────────────────────────────────────────────────────────
# SKOLAR main website — environment configuration
# Copy to .env.local for development. Set the same keys in Vercel.
# Anything WITHOUT the NEXT_PUBLIC_ prefix stays on the server.
# ──────────────────────────────────────────────────────────────

# Public site URL (used for metadata / sharing)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── Grok (xAI) — server only ─────────────────────────────────
XAI_API_KEY=
# Optional. Defaults to grok-4.7
XAI_MODEL=grok-4.7

# ── Firebase (same project as the SKOLAR Control Center) ─────
# Used server-side to READ published content via Firestore REST.
FIREBASE_PROJECT_ID=skolar-backend
FIREBASE_WEB_API_KEY=

# Optional: service account JSON (single line) — enables storing
# anonymous University Finder assessments in `finderAssessments`.
FIREBASE_SERVICE_ACCOUNT_JSON=
FINDER_STORE_ASSESSMENTS=false

# ── Contact (official details only — leave blank until confirmed) ──
# International format, digits only, no "+" (e.g. 391234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ── Content ──────────────────────────────────────────────────
# Shows clearly-labelled sample articles/platforms when Firestore
# has no published content (always on in `next dev`).
NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=false
# Shared secret the admin calls to refresh the homepage instantly
# after publishing: POST /api/revalidate  (header x-revalidate-secret)
REVALIDATE_SECRET=
