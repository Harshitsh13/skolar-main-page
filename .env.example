# ──────────────────────────────────────────────────────────────
# SKOLAR main website — environment configuration
# Copy to .env.local for development. Set the same keys in Vercel.
# Anything WITHOUT the NEXT_PUBLIC_ prefix stays on the server.
# ──────────────────────────────────────────────────────────────

# Public site URL (used for metadata / sharing)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── AI University Finder — server only (Groq or xAI Grok) ────
# Set GROQ_API_KEY (recommended) or XAI_API_KEY.
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b
GROQ_MODEL=openai/gpt-oss-120b
XAI_API_KEY=
# Optional. Defaults to grok-4.7
XAI_MODEL=grok-4.7

# ── Vercel Blob (optional / Admin & Control Center image store) ──
BLOB_READ_WRITE_TOKEN=

# ── SKOLAR Studio admin (/admin) ─────────────────────────────
# REQUIRED in production (the built-in default only works in `next dev`).
ADMIN_PASSWORD=
# Random string (32+ chars) used to sign admin sessions.
ADMIN_SESSION_SECRET=

# ── Firebase (same project as the SKOLAR Control Center) ─────
# Used server-side to READ published content via Firestore REST.
FIREBASE_PROJECT_ID=skolar-backend
FIREBASE_WEB_API_KEY=

# Optional: service account JSON (single line) — enables storing
# anonymous University Finder assessments in `finderAssessments`.
FIREBASE_SERVICE_ACCOUNT_JSON=
FINDER_STORE_ASSESSMENTS=false

# ── Contact (official details only — leave blank until confirmed) ──
# International format, digits only, no "+" (e.g. 391234567890)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_FACEBOOK=
NEXT_PUBLIC_SOCIAL_YOUTUBE=

# ── Content ──────────────────────────────────────────────────
# Shows clearly-labelled sample articles/platforms when Firestore
# has no published content (always on in `next dev`).
NEXT_PUBLIC_SHOW_SAMPLE_CONTENT=false
# Shared secret the admin calls to refresh the homepage instantly
# after publishing: POST /api/revalidate  (header x-revalidate-secret)
REVALIDATE_SECRET=

# ══════════════════════════ SKOLAR Studio ══════════════════════════
# Storage. With FIREBASE_SERVICE_ACCOUNT_JSON set, Studio uses Firestore
# (required on Vercel, and to share data between the website and the worker
# on different machines). Without it, a local folder is used (.studio-data).
# STUDIO_STORE=firestore|local        (optional override)
# STUDIO_DATA_DIR=                    (optional; default <project>/.studio-data)

# Encrypts AI provider keys pasted into Studio (min 16 chars). Optional if you
# reference keys by environment-variable name instead.
STUDIO_ENCRYPTION_KEY=

# Images: Studio stores ALL images in Vercel Blob (BLOB_READ_WRITE_TOKEN above,
# public store). Firebase Storage is not used.

# Publishing destination: GitHub when GITHUB_TOKEN/GITHUB_REPO are set; otherwise on
# Vercel the article is written to Firestore siteArticles (read by /insights/[slug]).
# Optional override: github | firestore | local
# STUDIO_PUBLISH_TARGET=

# GitHub publishing: fine-grained token with "Contents: read & write" on THIS repo only.
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
GITHUB_BRANCH=main
# GITHUB_CONTENT_DIR=content/insights

# Optional search discovery (one is enough). Research works without it,
# using the official source registry only.
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Optional: lets Vercel Cron call GET /api/studio/cron to publish due articles.
CRON_SECRET=
